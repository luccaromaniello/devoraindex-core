NODE_ENV=development
PUBLIC_URL=http://127.0.0.1:3000
POSTGRES_DB=devoraindex
POSTGRES_USER=devora
POSTGRES_PASSWORD=devora_dev_password

# Generate with: openssl rand -hex 32
OAUTH_ENCRYPTION_KEY=replace-with-64-hex-characters

# Required for a public HTTPS deployment. Leave empty for loopback development.
OAUTH_CLIENT_PRIVATE_JWK=
OAUTH_CLIENT_NAME=DevoraIndex
