{
	"name": "devoraindex-core",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.9.0"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"check": "npm run lint && npm run format:check && tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"oauth:generate-key": "tsx scripts/generate-oauth-key.ts",
		"docker:start": "prisma migrate deploy && node dist/server.js",
		"start": "node dist/server.js"
	},
	"dependencies": {
		"@atproto/oauth-client-node": "^0.5.7",
		"@hono/node-server": "^1.19.7",
		"@hono/zod-validator": "^0.7.6",
		"@prisma/client": "^6.19.0",
		"hono": "^4.11.4",
		"prisma": "^6.19.0",
		"redis": "^6.2.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@hono/zod-openapi": "^1.4.0",
		"@scalar/hono-api-reference": "^0.9.30",
		"@types/node": "^24.10.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3"
	}
}
